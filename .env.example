# WealthGuard LK - Environment Variables Template
# Copy this file to '.env' and fill in the values for local development.

# Google Gemini API Key (Optional - can also be configured in the app UI)
VITE_GEMINI_API_KEY=

# Google OAuth 2.0 Client ID for Google Drive Backup Sync
# Get this from your Firebase Project (under Authentication > Sign-in method > Google provider)
# or create one at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins must include: http://localhost:5173 (or your local dev port)
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
